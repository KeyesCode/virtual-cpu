{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "vcpu8-fixture/1"
    },
    "isaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "example",
        "instruction",
        "fault"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string"
    },
    "initial": {
      "type": "object",
      "properties": {
        "registers": {
          "minItems": 8,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "pc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "sp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "sd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "memory": {
          "minItems": 256,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": [
        "registers",
        "pc",
        "sp",
        "sd",
        "flags",
        "memory"
      ],
      "additionalProperties": false
    },
    "maxInstructions": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "HALTED"
            },
            "fault": {
              "type": "null"
            },
            "instructions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "registers": {
              "minItems": 8,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "pc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "flags": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "memory": {
              "minItems": 256,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "status",
            "fault",
            "instructions",
            "registers",
            "pc",
            "sp",
            "sd",
            "flags",
            "memory"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "FAULTED"
            },
            "fault": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "INVALID_OPCODE",
                    "MALFORMED_OPERAND",
                    "INSTRUCTION_OVERRUN",
                    "PC_OVERFLOW",
                    "DIVIDE_BY_ZERO",
                    "STACK_OVERFLOW",
                    "STACK_UNDERFLOW"
                  ]
                },
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "pc": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": [
                "code",
                "number",
                "pc"
              ],
              "additionalProperties": false
            },
            "instructions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "registers": {
              "minItems": 8,
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            },
            "pc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "flags": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "memory": {
              "minItems": 256,
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          },
          "required": [
            "status",
            "fault",
            "instructions",
            "registers",
            "pc",
            "sp",
            "sd",
            "flags",
            "memory"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "format",
    "isaVersion",
    "name",
    "kind",
    "description",
    "source",
    "initial",
    "maxInstructions",
    "expected"
  ],
  "additionalProperties": false,
  "title": "VCPU-8 hardware test fixture (vcpu8-fixture/1)",
  "description": "Initial state, instruction limit and expected final state of one VCPU-8 program, for verifying an RTL implementation against the emulator."
}
