# Pinned ASIC toolchain for the research engine's EDA sandbox (docs/research-engine/sandbox.md):
# OpenROAD and the OpenSTA inside it, from one OpenROAD-flow-scripts (ORFS) release, and the ORFS
# sky130hd platform files vendored beside this file (hardware/asic/sky130hd/SOURCE.md).
#
# Read by infrastructure/scripts/sandbox-build.sh (bash) and copied into the image, so keep every
# line a plain KEY=value with no quotes, spaces or shell expansion, like hardware/toolchain.env.
#
# ORFS publishes prebuilt images for linux/amd64 only, named by `git describe` at build time: the
# image of the 26Q4 tag's commit was built before the tag existed, hence its 26Q3-705 name. The
# image's `openroad -version` prints `unknown` (it is built without git metadata), so the OpenROAD
# and OpenSTA commits below, the submodules of that ORFS commit, are the version of record.

ORFS_TAG=26Q4
ORFS_COMMIT=ecb3cfdeb1cafd5c096dc4b3700f97a50329509c
ORFS_IMAGE=openroad/orfs:26Q3-705-gecb3cfdeb
ORFS_IMAGE_DIGEST=sha256:6da005d1c3447799f7401215174196c75ba9ec7e28417624d0c20225f85d594c
ORFS_PLATFORMS=linux/amd64

OPENROAD_COMMIT=c487fc7086ed2692b8e30cc4c16082788d30de12
OPENSTA_COMMIT=e983e15b2cb346badf8f23725fd3914d25312c44
OPENSTA_VERSION=3.1.0

SKY130HD_LIBERTY=lib/sky130_fd_sc_hd__tt_025C_1v80.lib
SKY130HD_LIBERTY_SHA256=ec0e1067a35c8bf20b11e58d1e8ac53326067e4dac84a125cc1b917a3518d0d9
