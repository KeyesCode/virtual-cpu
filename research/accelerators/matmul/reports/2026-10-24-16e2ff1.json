{
  "schemaVersion": 1,
  "kind": "matmul-rtl-benchmark",
  "revision": "matmul-os-r1",
  "arraySizes": ["4x4", "8x8", "16x16"],
  "labels": {
    "mac": "One MAC is one multiply plus one accumulate: a signed INT8 × INT8 product added into a signed INT32 accumulator. A workload of M × K by K × N is M · N · K MACs. Ops count each MAC as two operations (ops = 2 × MACs).",
    "cycles": "Cycles: rising clock edges of the Verilated matmul_top, counted by the Verilator runner (tb/sim/matmul_sim.cpp). They are clocks, not time: no clock frequency is assumed, so no time or throughput per second is reported.",
    "transfer": "Transfer in and transfer out: the simplified testbench host port (A and B written in parallel, one element per port per clock; C read one element per clock). It is a testbench convenience, not a production memory system.",
    "utilization": "PE utilization = MACs / (ROWS · COLS · compute cycles): the fraction of PE-clocks of the compute phase (PREPARE_TILE, COMPUTE and DRAIN of every tile) that did a useful MAC. STORE, transfer and handshake clocks are not in the denominator."
  },
  "formulas": {
    "macs": "macs = M · N · K",
    "tiles": "tiles = ⌈M / ROWS⌉ · ⌈N / COLS⌉",
    "utilization": "utilization = macs / (ROWS · COLS · compute)",
    "macsPerCycleCompute": "macsPerCycleCompute = macs / compute",
    "macsPerCycleTotal": "macsPerCycleTotal = macs / total",
    "opsPerCycleCompute": "opsPerCycleCompute = 2 · macs / compute",
    "opsPerCycleTotal": "opsPerCycleTotal = 2 · macs / total",
    "fillDrain": "fillDrain = compute − tiles · K (the PREPARE_TILE and DRAIN clocks)",
    "bytesIn": "bytesIn = M · K + K · N (INT8 operands)",
    "bytesOut": "bytesOut = 4 · M · N (INT32 results)"
  },
  "config": {
    "notation": "M × K × N (A is M × K, B is K × N, C is M × N)",
