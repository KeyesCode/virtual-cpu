{
  "schemaVersion": 1,
  "id": "buffer-capacity",
  "description": "MAX_DIM 32 versus 64 versus 128 on the 8 × 8 array: the cells and memory bits each buffer capacity costs against the largest workload it can run.",
  "verify": { "seed": 1, "count": 40 },
  "benchmark": { "seed": 1 },
  "workloads": [
    { "m": 4, "k": 4, "n": 4, "what": "cube: one 4 × 4 tile" },
    { "m": 8, "k": 8, "n": 8, "what": "cube" },
    { "m": 16, "k": 16, "n": 16, "what": "cube" },
    { "m": 32, "k": 32, "n": 32, "what": "cube: the largest within MAX_DIM 32" },
    { "m": 64, "k": 64, "n": 64, "what": "cube: the largest within MAX_DIM 64" },
    { "m": 128, "k": 128, "n": 128, "what": "cube: the largest within MAX_DIM 128" },
    { "m": 13, "k": 19, "n": 11, "what": "non-square, edge tiles in M and N" },
    { "m": 64, "k": 8, "n": 64, "what": "large C, short reduction (K = 8)" },
    { "m": 8, "k": 64, "n": 64, "what": "few output rows, long reduction" },
    { "m": 1, "k": 64, "n": 1, "what": "one dot product of length 64" },
    { "m": 100, "k": 77, "n": 120, "what": "non-square, above MAX_DIM 64" },
    { "m": 1, "k": 128, "n": 1, "what": "one dot product of length 128" }
  ],
  "baseline": "max-dim-64",
  "variants": [
    {
      "name": "max-dim-32",
      "description": "32 × 32 elements per matrix buffer.",
      "parameters": { "ROWS": 8, "COLS": 8, "MAX_DIM": 32 }
    },
    {
      "name": "max-dim-64",
      "description": "64 × 64 elements per matrix buffer (the default).",
      "parameters": { "ROWS": 8, "COLS": 8, "MAX_DIM": 64 }
    },
    {
      "name": "max-dim-128",
      "description": "128 × 128 elements per matrix buffer.",
      "parameters": { "ROWS": 8, "COLS": 8, "MAX_DIM": 128 }
    }
  ]
}
