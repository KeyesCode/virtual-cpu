# Pinned hardware toolchain for VCPU-8 Project 2: one dated YosysHQ OSS CAD Suite release.
#
# Read by hardware/scripts/setup-toolchain.sh (bash) and included by hardware/rtl/vcpu8/Makefile
# (make), so keep every line a plain KEY=value with no quotes, spaces or shell expansion.
#
# To move to a newer release, copy the tag, the tarball names and their sha256 digests from
# https://github.com/YosysHQ/oss-cad-suite-build/releases, then run `pnpm hardware:setup`.

OSS_CAD_SUITE_VERSION=2026-10-16
OSS_CAD_SUITE_BASE_URL=https://github.com/YosysHQ/oss-cad-suite-build/releases/download/2026-10-16

