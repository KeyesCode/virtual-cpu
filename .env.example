# Copy to .env (git-ignored) for local development. Never commit real values.

# Connection strings the API and worker use. Keep their ports in step with the ones below.
DATABASE_URL=postgres://research:research@127.0.0.1:5432/research
REDIS_URL=redis://127.0.0.1:6379

# Bearer token for mutating routes and artifact downloads. Generate your own:
#   openssl rand -hex 32
RESEARCH_API_TOKEN=

# Content-addressed artifact store, relative to the repository root.
RESEARCH_ARTIFACT_ROOT=.research/artifacts

# The pinned EDA sandbox image (built by `pnpm research:sandbox:build`).
EDA_SANDBOX_IMAGE=silicon-lab/eda-sandbox:latest

# Docker Compose (infrastructure/docker/compose.yml). Change a port here if something on this
# machine already holds it, then update DATABASE_URL or REDIS_URL to match.
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
POSTGRES_PORT=5432
REDIS_PORT=6379
