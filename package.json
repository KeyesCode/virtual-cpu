{
  "name": "vcpu-8",
  "version": "0.0.0",
  "private": true,
  "description": "VCPU-8: an educational 8-bit virtual CPU, assembler, debugger and dashboard.",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cpu": "pnpm --silent --filter @vcpu/cli start --",
    "bench": "pnpm --silent cpu benchmark --suite",
    "bench:compare": "pnpm --silent cpu benchmark --compare",
    "fixtures:export": "tsx scripts/export-fixtures.ts",
    "hardware:setup": "bash hardware/scripts/setup-toolchain.sh",
    "hardware:gen": "pnpm --silent --filter @vcpu/rtl-tools gen:isa",
    "hardware:lint": "make -C hardware/rtl/vcpu8 lint",
    "hardware:test": "make -C hardware/rtl/vcpu8 test",
    "hardware:simulate": "make -C hardware/rtl/vcpu8 simulate",
    "hardware:wave": "make -C hardware/rtl/vcpu8 wave",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "@vcpu/assembler": "workspace:*",
    "@vcpu/cpu-core": "workspace:*",
    "@vcpu/shared": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.2",
    "vitest": "catalog:"
  }
}
